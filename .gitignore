/monitor

# WiFi credentials — copy secrets.h.example to secrets.h and fill in
/secrets.h

# local build counter (version stamp) and OS cruft
/.build_number
.DS_Store

# Local publish-prep notes
PUBLISH_CHECKLIST.md
